#!/bin/sh
# pre-commit — check_docs.py --gate 강제 (2026-08-26 신설, 해달별님 지시)
#
# 왜 — "커밋 전 check_docs.py 를 돌린다"가 사람의 의지에 맡겨져 있었다. 이 훅은 그 의지를
# 없애고 종료코드로 강제한다. --gate 모드만 쓴다 — 매니페스트(run_manifest) 미준수·
# prereg 링크 누락, 이 둘(CLAUDE.md §6-1 「강제 2개」)만 커밋을 막고, 그 밖의 경고
# (미커밋 파일·push 대기·부산물 대기 등)는 정보로만 보여주고 막지 않는다 — 안 그러면
# 실측(2026-08-23) 경고 105건이 상시 떠 게이트가 무력해진다(check_docs.py 자체 주석 참조).
#
# 우회 — 급하면 `git commit --no-verify`. 단 CLAUDE.md §4-6 대로 왜 우회했는지 커밋
# 메시지나 대화에 남길 것. 이 훅 자체를 지우거나 core.hooksPath 를 되돌리면 원복된다.
#
# 이 훅은 5개 저장소(quant_infra·s2_method·s2-trading-web·t1_method·QuantBacktest)에
# 전부 동일하게 깔려 있다 — check_docs.py 가 어차피 절대경로로 5개를 전부 훑으므로
# 어느 저장소에서 커밋하든 같은 검사를 받는다.

PYTHON="/c/Python314/python.exe"
CHECK="/c/AI파운더스/quant_infra/check_docs.py"

if [ ! -f "$CHECK" ]; then
    echo "[pre-commit] check_docs.py 를 찾을 수 없다 — 건너뜀: $CHECK"
    exit 0
fi

"$PYTHON" "$CHECK" --gate
rc=$?

if [ $rc -ne 0 ]; then
    echo ""
    echo "[pre-commit] ★★check_docs.py --gate 위반 — 커밋을 막는다."
    echo "  고치고 다시 커밋하거나, 급하면 'git commit --no-verify' 로 우회(사유를 남길 것)."
fi

exit $rc
